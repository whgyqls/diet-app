# Copy to .env.local and fill in the values. .env.local is never committed.
# On Netlify the same names are entered in the site's environment variables (values are not written here).

# Supabase project URL, without a path: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key. It is meant to be public: the data is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. SERVER ONLY (account deletion). Never use a NEXT_PUBLIC_ prefix for it.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key for the AI explanation. SERVER ONLY: never use a NEXT_PUBLIC_ prefix for it.
OPENROUTER_API_KEY=
# Optional: overrides the FIRST model only. Empty or unset = DEFAULT_MODEL in src/lib/explain/config.ts (not set in production).
# OPENROUTER_MODEL=
